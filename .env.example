# Public project coordinates (the anon key is protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase secret (recommended: sb_secret_...; legacy service_role also works).
# Never use the NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key

# Public deployment origin used in the iPhone Shortcut setup screen.
NEXT_PUBLIC_APP_URL=https://ultra-pilot.vercel.app
